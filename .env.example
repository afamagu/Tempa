# Supabase — publishable/anon key, used by every ordinary request
# (lib/supabase/server.ts, lib/supabase/client.ts). Safe to expose to
# the browser; RLS is what actually scopes access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — service_role key. Server-only (lib/supabase/service.ts).
# Bypasses RLS entirely — never expose this to the browser, never
# prefix it with NEXT_PUBLIC_. Used only by trusted server infrastructure.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — transactional email provider for arrival emails.
# RESEND_API_KEY is read by lib/email/provider.ts. ARRIVAL_EMAIL_FROM
# (the verified From address/domain on jointempa.com) is read once by
# lib/email/arrival-worker.ts and frozen into each event's provider-
# request snapshot at first attempt — never re-read per retry.
RESEND_API_KEY=
ARRIVAL_EMAIL_FROM="Tempa <letters@jointempa.com>"

# The public HTTPS origin the arrival-email deep link points at
# (lib/email/arrival.ts's siteOrigin). No trailing path.
NEXT_PUBLIC_SITE_ORIGIN=https://jointempa.com

# Optional — public HTTPS base URL hosting the arrival-email origin art
# assets (lib/email/arrival.ts's ORIGIN_ARRIVAL_ART, served from
# public/email/arrival-art/). Unlike NEXT_PUBLIC_SITE_ORIGIN above, a
# pathname is allowed here (see lib/email/arrival.ts's artBaseUrl) — a
# trailing slash is optional and normalized either way. Leave unset to
# send arrival emails without the art image.
ARRIVAL_EMAIL_ART_ORIGIN=https://jointempa.com/email/arrival-art

# Bearer secret the scheduler must present as
# `Authorization: Bearer $CRON_SECRET` to app/api/cron/arrival-emails.
# The Vercel project is on the Hobby tier, which only allows once-daily
# native Vercel Cron — production instead uses Supabase Cron + pg_net
# + Vault to call this route every 5 minutes (see docs/sql/2026-10-02-
# arrival-email-scheduler.sql and docs/arrival-email-scheduler.md).
# Generate a long random value; treat it like a password. The SAME
# value must also be stored in Supabase Vault under the name
# tempa_arrival_email_cron_secret — see that doc for the handshake.
CRON_SECRET=

# Commerce Checkpoint 5 — Flutterwave TEST MODE (server-only; never NEXT_PUBLIC_).
# Checkout refuses to run unless the secret key is a TEST key (FLWSECK_TEST-…).
# FLUTTERWAVE_WEBHOOK_HASH is the "secret hash" set in the Flutterwave dashboard
# (Settings → Webhooks); Flutterwave sends it in the `verif-hash` header.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# Azure Translator — machine translation provider (server-only; never NEXT_PUBLIC_).
# Create an Azure Translator F0 resource. A global single-service resource may
# leave REGION blank; regional/multi-service resources require it. The app's own
# monthly guard defaults to 1.8M source characters and refuses a value above the
# Azure F0 allowance of 2M/month. See docs/translation-foundation.md.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
TRANSLATION_MONTHLY_CHARACTER_LIMIT=1800000
